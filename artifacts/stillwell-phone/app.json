{
  "expo": {
    "name": "Stillwell Patient App",
    "slug": "stillwell-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stillwell-phone",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f5f4ed",
      "image": "./assets/images/icon.png",
      "imageWidth": 112,
      "resizeMode": "contain"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#f5f4ed"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Stillwell to record a private voice check-in on this device.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
